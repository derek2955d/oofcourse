# No credentials are required to browse the real empty-state website.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Trusted callback origin; localhost default or Vercel deployment origin if omitted.
SITE_URL=
# Enable indexing only after operator/legal details and production checks are complete.
SITE_INDEXABLE=false
# Disable separate, noindex layout previews for production.
ENABLE_LAYOUT_PREVIEWS=true
# Optional: expiry automation ONLY; these values must remain server-side.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Keep the optional member outing prototype paused unless its policy is approved.
WEEKEND_SUBMISSIONS_ENABLED=false

# Optional AI draft assistant. Disabled until an operator approves a provider/budget.
# Server-only: never prefix these with NEXT_PUBLIC_.
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
ASSISTANT_MODEL=
