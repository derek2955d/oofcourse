# Public browsing and the local demo workspace need no credentials.
# Set BOTH public Supabase values only after applying the migrations.
# The admin uses a provisioned Supabase Auth user plus admin_users(role=admin).
# No service-role key is needed by the implemented admin.
# Keep false until demo content is replaced and a production review is complete.
SITE_INDEXABLE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; never prefix a service-role key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Reserved for future privacy-reviewed analytics; no provider is active.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
